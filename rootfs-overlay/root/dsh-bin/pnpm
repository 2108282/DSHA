#!/bin/bash
# DSHA: 仅禁止执行 pnpm build / pnpm run build，防破坏系统运行时软链接

REAL_PNPM="/usr/local/bin/node /usr/local/lib/dsha-pnpm/bin/pnpm.cjs"

# 仅精确拦截 build 与 run build
if [ "$1" = "build" ] || ([ "$1" = "run" ] && [ "$2" = "build" ]); then
  echo "❌ [DSHA 拦截] 已禁止运行 pnpm $*：该操作会破坏内置插件与系统共享符号链接！" >&2
  exit 1
fi

# 其他所有命令完全原样放行
exec $REAL_PNPM "$@"
