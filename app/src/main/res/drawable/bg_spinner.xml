<?xml version="1.0" encoding="utf-8"?>
<!-- 下拉框背景：与输入框同款圆角描边，右侧自带箭头。
     直接把 bg_input 套给 Spinner 会连系统自带的箭头一起盖掉，
     用户就看不出这是个可展开的选择器了。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/stroke"
                android:color="@color/line" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_chevron_down"
        android:gravity="center_vertical|end"
        android:end="@dimen/gap_control" />
</layer-list>
