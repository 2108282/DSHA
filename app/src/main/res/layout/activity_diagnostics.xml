<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_pad">

        <Button
            android:id="@+id/diagnostic_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="‹ 返回"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            style="@style/DshaText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="诊断与修复" />

        <TextView
            android:id="@+id/diagnostic_status"
            style="@style/DshaText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/diagnostic_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn"
            android:text="重新诊断"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/diagnostic_repair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn"
            android:text="修复证书与 npm"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/diagnostic_plugins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn"
            android:text="前往插件页使用备用文件选择器"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <EditText
            android:id="@+id/diagnostic_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="补充复现步骤（请勿填写密钥或私人对话）"
            android:inputType="textMultiLine"
            android:maxLength="2000"
            android:minHeight="96dp"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/diagnostic_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:text="复制反馈信息"
                android:textAllCaps="false"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/diagnostic_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:text="导出诊断报告"
                android:textAllCaps="false"
                android:textColor="@color/text" />
        </LinearLayout>

        <TextView
            android:id="@+id/diagnostic_report"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
