<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="配置模块"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="DeepSeek API Key" />

        <EditText
            android:id="@+id/config_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="端口（默认 3080）" />

        <EditText
            android:id="@+id/config_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3080"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="模型（默认 deepseek-v4-flash）" />

        <EditText
            android:id="@+id/config_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="deepseek-v4-flash" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="沙箱权限模式" />

        <Spinner
            android:id="@+id/config_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/config_confirm_shell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="危险 Shell 操作需确认（删除/格式化/卸载/重启等）" />

        <CheckBox
            android:id="@+id/config_check_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启动时检查更新" />

        <Button
            android:id="@+id/config_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="保存配置" />

        <TextView
            android:id="@+id/config_repo_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="DSHA v1.0.0"
            android:textColor="#999999"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
