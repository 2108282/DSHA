<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/gap_control"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_section">

        <TextView
            android:id="@+id/sub_back"
            style="@style/DshaText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/gap_tight"
            android:text="‹ 返回"
            android:visibility="gone" />

        <TextView
            style="@style/DshaText.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="配置" />

        <TextView
            android:id="@+id/config_workspace_entry"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/gap_control"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:text="数据与备份 · 备份/恢复 · 环境管理" />

        <!-- ========== 接入 ========== -->
        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView
                style="@style/DshaText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Key" />

            <TextView
                style="@style/DshaText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:text="DeepSeek API Key" />

            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="可留空 —— 装好后在 WebUI 的设置里也能配置官方或第三方 API（自定义接口地址与模型）" />

            <EditText
                android:id="@+id/config_api_key"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/bg_input"
                android:hint="sk-..."
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="@dimen/gap_control"
                android:paddingEnd="@dimen/gap_control" />

            <!-- 高级项默认收起：端口几乎没人改、模型在 WebUI 里也能配、
                 沙箱模式是高级概念。全铺在首屏只会让必填的 API Key 被淹没。 -->
            <TextView
                android:id="@+id/config_adv_header"
                style="@style/DshaText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/gap_tight"
                android:paddingBottom="@dimen/gap_tight"
                android:text="▸ 高级：端口与 CPU 调度 (Taskset)" />

            <LinearLayout
                android:id="@+id/config_adv_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/DshaText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:text="端口" />

                <EditText
                    android:id="@+id/config_port"
                    style="@style/DshaText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:background="@drawable/bg_input"
                    android:hint="3080"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="@dimen/gap_control"
                    android:paddingEnd="@dimen/gap_control" />

                <TextView
                    style="@style/DshaText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:text="CPU 核心绑定 (Taskset)" />

                <TextView
                    style="@style/DshaText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="设置容器守护进程及 Agent 任务的 CPU 亲和性。例如 0-6（避开超大核降温防烫）、0-4,7 或留空（全核调度）。" />

                <EditText
                    android:id="@+id/config_taskset"
                    style="@style/DshaText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:background="@drawable/bg_input"
                    android:hint="如 0-6 或 0-4,7（留空不限制）"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="@dimen/gap_control"
                    android:paddingEnd="@dimen/gap_control" />

            </LinearLayout>
        </LinearLayout>

        <!-- ========== 行为 ========== -->
        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_control">

            <TextView
                style="@style/DshaText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="行为" />

            <CheckBox
                android:id="@+id/config_confirm_shell"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:minHeight="@dimen/touch_min"
                android:paddingStart="@dimen/gap_tight"
                android:text="危险 Shell 操作需确认（删除/格式化/卸载/重启等）" />

            <TextView
                android:id="@+id/config_guard_status"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_tight"
                android:layout_marginTop="@dimen/gap_hair"
                android:visibility="gone" />


            <CheckBox
                android:id="@+id/config_lan_mode"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:paddingStart="@dimen/gap_tight"
                android:text="局域网访问（同网段设备可打开，注意安全）" />

            <CheckBox
                android:id="@+id/config_overlay_stream"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:paddingStart="@dimen/gap_tight"
                android:text="屏幕顶部流式显示 AI 输出（需悬浮窗权限；内容旁人可见）" />

            <TextView
                android:id="@+id/config_overlay_style"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight"
                android:text="悬浮条外观与行为 ▸ 底色 / 透明度 / 行数 / 停留时间 / 思考过程 / 就地批准" />

            <TextView
                android:id="@+id/config_translate"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight"
                android:text="插件市场自动翻译 ▸ 开关 / 接口地址 / 模型 / Key" />

            <CheckBox
                android:id="@+id/config_cap_sensors"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许 agent 读传感器、开手电（环境光 / 加速度 / 磁力等，无隐私风险）" />

            <CheckBox
                android:id="@+id/config_cap_location"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许 agent 读取位置（能定位到你本人，默认关闭）" />

            <!-- 所有文件访问权限：容器要读写手机存储任意文件（含 DSHA 目录外），
                 得去系统设置页开 MANAGE_EXTERNAL_STORAGE，这里只做入口 + 状态。 -->
            <LinearLayout
                android:id="@+id/config_all_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/DshaText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="所有文件的访问权限 ▸" />

                    <TextView
                        android:id="@+id/config_all_files_status"
                        style="@style/DshaText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/config_rc6"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:paddingStart="@dimen/gap_tight"
                android:text="deepseek-harness：默认最新 RC"
                android:visibility="gone" />

            <TextView
                style="@style/DshaText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:text="自动备份（每启动 N 次备份一次，0 = 关闭）" />

            <EditText
                android:id="@+id/config_auto_backup"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/bg_input"
                android:hint="5"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingStart="@dimen/gap_control"
                android:paddingEnd="@dimen/gap_control"
                android:text="5" />
        </LinearLayout>

        <Button
            android:id="@+id/config_save"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/gap_section"
            android:background="@drawable/bg_btn_primary"
            android:text="保存配置"
            android:textAllCaps="false"
            android:textColor="@color/accent_on"
            android:textSize="@dimen/text_body" />

        <!-- ========== 系统与设备权限 ========== -->
        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView
                style="@style/DshaText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统与设备权限" />

            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="当前运行在 KernelSU / Magisk 原生 Root 模式下，底层命令直通物理设备，无需配置 ADB 或无线调试。" />

            <Button
                android:id="@+id/config_battery_opt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_control"
                android:background="@drawable/bg_btn"
                android:text="🔋 关闭电池优化（后台稳定保活必做）"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/config_battery_opt_hint"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="系统休眠可能会冻结后台网络与长任务。加入白名单后后台守护与长任务才能平稳运行。" />

            <Button
                android:id="@+id/config_a11y"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_control"
                android:background="@drawable/bg_btn"
                android:text="👆 屏幕操作权限（无障碍服务 · 读屏/点击/输入）"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/config_a11y_status"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_tight"
                android:layout_marginTop="@dimen/gap_hair" />
        </LinearLayout>

        <TextView
            android:id="@+id/config_repo_link"
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:gravity="center"
            android:text="DSHA" />
    </LinearLayout>
</ScrollView>
