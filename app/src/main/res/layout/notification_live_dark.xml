<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_live_dark"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- 顶部标题与右上角应用图标 -->
    <RelativeLayout
        android:id="@+id/notif_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/notif_icon"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:text="正在执行自动化任务..."
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_whale_logo"
            android:scaleType="fitCenter" />
    </RelativeLayout>

    <!-- 中间细分割线 (RemoteViews 必须使用 ImageView 或 FrameLayout 代替 View) -->
    <ImageView
        android:id="@+id/notif_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/notif_header"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#26FFFFFF" />

    <!-- 底部状态与操作按钮 -->
    <RelativeLayout
        android:id="@+id/notif_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/notif_divider">

        <LinearLayout
            android:id="@+id/notif_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/notif_btn_action"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时状态"
                android:textColor="#58A6FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="智能体正在分析并执行任务..."
                android:textColor="#D0D0D0"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 右侧深灰药丸按钮 -->
        <LinearLayout
            android:id="@+id/notif_btn_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notif_btn_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_alarm_white"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/notif_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="停止任务"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
