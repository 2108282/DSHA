<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/gap_control"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_section">

        <TextView
            android:id="@+id/sub_back"
            style="@style/DshaText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/gap_tight"
            android:text="‹ 返回"
            android:visibility="visible" />

        <TextView
            style="@style/DshaText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="抽屉设置" />

        <!-- 快捷抽屉外观与手势交互配置卡片 -->
        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_control"
            android:orientation="vertical">

            <!-- 1. 抽屉正反色（抽屉反色开关） -->
            <LinearLayout
                android:id="@+id/sheet_settings_invert_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="🌗"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="抽屉反色开关"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="快捷抽屉独立深色反色，与主应用黑夜白天完全分离"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sheet_settings_invert_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <!-- 2. 抽屉莫奈取色（Material You 动态调色板） -->
            <LinearLayout
                android:id="@+id/sheet_settings_monet_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="🎨"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="抽屉莫奈取色"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="跟随系统壁纸提取 Material You 调色板（仅浅色模式生效，打开反色不使用）"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sheet_settings_monet_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <!-- 3. 圈定即搜重定向（增加 Google 和语音识别说明） -->
            <LinearLayout
                android:id="@+id/sheet_settings_cts_redirect_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="◎"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="圈定即搜重定向"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:lineSpacingExtra="2dp"
                        android:text="圈选手势直接唤起快捷抽屉（需 LSPosed 激活模块并重启）\n需要安装google和谷歌语音识别，并将语音助理选择为google"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sheet_settings_cts_redirect_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <!-- 3. 抽屉白天不透明度 -->
            <LinearLayout
                android:id="@+id/sheet_settings_opacity_day_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="☀️"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="抽屉白天不透明度"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="浅色底板 (30~100%)，默认 88%"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <EditText
                    android:id="@+id/sheet_settings_opacity_day_input"
                    android:layout_width="56dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="88"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="%"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/sheet_settings_opacity_day_save"
                    style="@style/Widget.DSHA.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="保存"
                    android:textColor="@color/accent_on"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <!-- 4. 抽屉黑夜不透明度 -->
            <LinearLayout
                android:id="@+id/sheet_settings_opacity_night_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="🌙"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="抽屉黑夜不透明度"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="深色底板 (30~100%)，默认 80%"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <EditText
                    android:id="@+id/sheet_settings_opacity_night_input"
                    android:layout_width="56dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="80"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="%"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/sheet_settings_opacity_night_save"
                    style="@style/Widget.DSHA.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="保存"
                    android:textColor="@color/accent_on"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
