<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/extract_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在准备运行环境"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2328" />

    <ProgressBar
        android:id="@+id/extract_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp" />

    <TextView
        android:id="@+id/extract_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="首次启动需要解压内置环境，请稍候…"
        android:textSize="14sp"
        android:textColor="#656D76"
        android:gravity="center" />

    <TextView
        android:id="@+id/extract_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:textSize="13sp"
        android:textColor="#D1242F"
        android:gravity="center" />
</LinearLayout>
