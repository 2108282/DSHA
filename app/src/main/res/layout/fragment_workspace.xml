<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="工作区管理"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="工作区目录名（rootfs 内）" />

        <EditText
            android:id="@+id/workspace_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="deepseek-harness" />

        <Button
            android:id="@+id/workspace_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="应用路径" />

        <TextView
            android:id="@+id/workspace_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="文件共享（MT 注入文件提供器 · 无需 ROOT）"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workspace_share_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="尚未加载"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="设备 Shell 能力（Shizuku）"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workspace_shizuku_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Shizuku 未授权"
            android:textSize="13sp" />

        <Button
            android:id="@+id/workspace_shizuku_auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="授权 Shizuku" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="授权后，助手（Web UI 里的 agent）可在设备上执行 shell 命令：\ncurl http://127.0.0.1:3090/exec?cmd=..."
            android:textSize="12sp" />

        <Button
            android:id="@+id/workspace_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="备份全部数据（导出到外部存储）" />

        <Button
            android:id="@+id/workspace_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="从备份恢复（选择备份文件）" />

        <Button
            android:id="@+id/workspace_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="重置配置（保留对话记录）" />

        <Button
            android:id="@+id/workspace_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="清除环境" />
    </LinearLayout>
</ScrollView>
