<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- 主页面内容区域（底部留出悬浮底栏空间） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- SukiSU-Ultra 风格沉浸式顶栏 -->
        <LinearLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/page_pad">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_logo">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_terminal"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/app_title"
                    style="@style/DshaText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="启动"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/app_subtitle"
                    style="@style/DshaText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DSHA · KernelSU / Magisk Native"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/appbar_spacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_theme"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="黑夜"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/btn_about"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:contentDescription="关于"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_about"
                    app:tint="@color/text_secondary" />
            </FrameLayout>
        </LinearLayout>

        <!-- 内容承载容器：底部 padding 84dp 留给悬浮底栏 -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="76dp" />
    </LinearLayout>

    <!-- SukiSU-Ultra 悬浮药丸底栏（Floating Bottom Bar） -->
    <FrameLayout
        android:id="@+id/floating_bottom_bar_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pill_height"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="@dimen/pill_horizontal_margin"
        android:layout_marginEnd="@dimen/pill_horizontal_margin"
        android:layout_marginBottom="@dimen/pill_bottom_margin"
        android:background="@drawable/bg_pill_bar"
        android:elevation="@dimen/pill_elevation"
        android:padding="5dp">

        <!-- 滑动高亮胶囊指示器 -->
        <View
            android:id="@+id/pill_indicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pill_indicator" />

        <!-- Tab 列表 -->
        <LinearLayout
            android:id="@+id/floating_tabs_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tab 0: 启动 -->
            <LinearLayout
                android:id="@+id/tab_item_launch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_icon_launch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_launch"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tab_text_launch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="启动"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 1: 终端 -->
            <LinearLayout
                android:id="@+id/tab_item_terminal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_icon_terminal"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_terminal"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tab_text_terminal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="终端"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 2: 插件 -->
            <LinearLayout
                android:id="@+id/tab_item_plugins"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_icon_plugins"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_plugins"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tab_text_plugins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="插件"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 3: 设置 -->
            <LinearLayout
                android:id="@+id/tab_item_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_icon_settings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tab_text_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="设置"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 兼容隐藏的原生 BottomNavigationView（用于防止任何旧反射或兼容性调用报错） -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:menu="@menu/bottom_nav_menu"
        tools:ignore="MissingConstraints" />

</FrameLayout>
