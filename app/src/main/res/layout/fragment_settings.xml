<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="@dimen/gap_tight"
        android:paddingBottom="@dimen/gap_section">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginBottom="@dimen/gap_control"
            android:text="模块"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/settings_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginTop="@dimen/gap_block"
            android:layout_marginBottom="@dimen/gap_control"
            android:text="其他"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查更新"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_update_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="DSH 稳定版 · 测试版 · 客户端与模块"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_selftest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="诊断与修复"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="脱敏反馈 · 导出报告 · 证书 / npm 修复"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_apply_patches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="🛠"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="原生环境与存储直通自愈"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:lineSpacingExtra="2dp"
                        android:text="内部存储直通 · 默认工作区检查 · DNS 修复 · 3095 设备桥 · 插件自愈"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_sheet_immersive_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="✨"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快捷抽屉沉浸全透明"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="消除抽屉实心底色，透出毛玻璃底板与桌面壁纸"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/settings_sheet_immersive_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_sheet_opacity_day_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="☀️"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="抽屉白天不透明度"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="浅色底板 (30~100%)，默认 88%"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <EditText
                    android:id="@+id/settings_sheet_opacity_day_input"
                    android:layout_width="56dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="88"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="%"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/settings_sheet_opacity_day_save"
                    style="@style/Widget.DSHA.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="保存"
                    android:textColor="@color/accent_on"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_sheet_opacity_night_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="🌙"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="抽屉黑夜不透明度"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="深色底板 (30~100%)，默认 80%"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <EditText
                    android:id="@+id/settings_sheet_opacity_night_input"
                    android:layout_width="56dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="80"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="%"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/settings_sheet_opacity_night_save"
                    style="@style/Widget.DSHA.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="保存"
                    android:textColor="@color/accent_on"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_reextract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="⟳"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="重新解压内置环境"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="dsh / npm 损坏时用；配置与对话记录会保留"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关于 DSHA"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="GitHub 仓库 · QQ 交流群 · 开源协议"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/settings_ver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_block"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="DSHA"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</ScrollView>
