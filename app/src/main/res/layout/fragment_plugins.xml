<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pluginScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="24dp">

        <!-- ================= SukiSU-Ultra 风格分段胶囊 Tab ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnMarket"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_on"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="插件市场"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnInstalled"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="插件管理"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRefresh"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:contentDescription="刷新插件状态"
                android:focusable="true"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ================= 发现更多插件卡片 ================= -->
        <LinearLayout
            android:id="@+id/pluginWebsiteSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_ultra"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/DshaText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="发现官方与社区插件"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="在官方目录选取所需扩展并在 DSHA 中一键激活，支持即时安装与在线热加载。"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPluginWebsite"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary_pill"
                android:fontFamily="sans-serif-medium"
                android:text="前往 dsha.cc 浏览插件库"
                android:textAllCaps="false"
                android:textColor="@color/accent_on"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= 链接安装卡片 ================= -->
        <LinearLayout
            android:id="@+id/pluginLinkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_ultra"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/DshaText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="通过链接直接安装"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/appbar_github_input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="粘贴 GitHub 链接、Release 附件或 owner/repo"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pluginLinkHint"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPluginPaste"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="粘贴链接"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPluginInstall"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="解析并安装"
                    android:textColor="@color/accent_on"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= 本地导入与导出按钮行 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnImport"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_ultra_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📦 导入插件包"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_ultra_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📤 导出插件包"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnImportFallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="使用备用文件选择器 ›"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- 忙碌指示条 -->
        <ProgressBar
            android:id="@+id/pluginBusy"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <!-- 状态反馈标签 -->
        <TextView
            android:id="@+id/statusText"
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:contentDescription="插件操作状态，点按查看完整信息"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="2"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <!-- ================= 市场指引卡片 ================= -->
        <LinearLayout
            android:id="@+id/marketHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_ultra"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/DshaText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="安装规范与热生效说明"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="• 链接安装：支持 GitHub 仓库、分支、Release 附件与 npm 预构建包。\n• 本地导入：支持 ZIP、TAR.GZ 等已打包好的扩展。\n• 生效方式：安装、切换开关或卸载后，重启服务即可全域生效。"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= 已安装插件管理控制区 ================= -->
        <LinearLayout
            android:id="@+id/installedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPluginUpdates"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:background="@drawable/bg_btn_secondary_pill"
                android:fontFamily="sans-serif-medium"
                android:text="🔍 检查第三方插件更新"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pluginSearch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="搜索已安装插件名称或关键词…"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/chkHideBuiltin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/primary"
                android:minHeight="44dp"
                android:text="只显示用户自定义安装的插件"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/chkThirdPartyCompat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary"
                android:minHeight="44dp"
                android:text="第三方扩展兼容增强（宽松沙箱白名单）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pluginCount"
                    style="@style/DshaText.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnSort"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="名称排序 ⇅"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 空态占位 -->
        <TextView
            android:id="@+id/pluginEmpty"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="暂无匹配插件"
            android:textColor="@color/text_muted"
            android:visibility="gone" />

        <!-- 插件 RecyclerView 列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pluginList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
