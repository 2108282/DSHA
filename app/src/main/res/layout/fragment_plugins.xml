<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="2dp"
        android:paddingBottom="@dimen/gap_tight">

        <TextView
            android:id="@+id/btnMarket"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_on"
            android:gravity="center"
            android:text="插件市场"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInstalled"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:layout_weight="1"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="插件管理"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:paddingStart="@dimen/gap_control"
            android:paddingEnd="@dimen/gap_control"
            android:text="排序"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:paddingStart="@dimen/gap_control"
            android:paddingEnd="@dimen/gap_control"
            android:gravity="center"
            android:text="筛选"
            android:textColor="#E6EDF3"
            android:textSize="@dimen/text_label"
            android:background="@drawable/bg_btn" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_tight"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:text="导出插件包"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/btnImport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:layout_weight="1"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:text="导入插件包"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/chkHideBuiltin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_pad"
        android:buttonTint="@color/primary"
        android:text="隐藏 dsh 自带插件（只看自己装的）"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_label"
        android:visibility="gone" />


    <EditText
        android:id="@+id/pluginSearch"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="@dimen/page_pad"
        android:layout_marginEnd="@dimen/page_pad"
        android:layout_marginBottom="@dimen/gap_tight"
        android:background="@drawable/bg_input"
        android:hint="搜索插件名称…"
        android:imeOptions="actionSearch"
        android:paddingStart="@dimen/card_pad"
        android:paddingEnd="@dimen/card_pad"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_muted"
        android:textSize="@dimen/text_body" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pluginList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="8dp" />

    <ProgressBar
        android:id="@+id/pluginBusy"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/gap_control"
        android:text="加载中…"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
