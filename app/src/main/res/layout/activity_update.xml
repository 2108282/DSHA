<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_pad">

        <Button
            android:id="@+id/update_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="‹ 返回"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary" />

        <TextView
            style="@style/DshaText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="应用更新" />

        <TextView
            android:id="@+id/update_current"
            style="@style/DshaText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <RadioGroup
            android:id="@+id/update_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/update_stable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="稳定版" />

            <RadioButton
                android:id="@+id/update_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="预览版" />
        </RadioGroup>

        <TextView
            android:id="@+id/update_status"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true" />

        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/update_bytes"
            style="@style/DshaText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/update_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn"
            android:text="取消下载 / 检查"
            android:textAllCaps="false"
            android:textColor="@color/err"
            android:visibility="gone" />

        <TextView
            android:id="@+id/update_notes"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/update_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:text="检查更新 / 重试"
            android:textAllCaps="false"
            android:textColor="@color/accent_on" />

        <Button
            android:id="@+id/update_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn"
            android:text="下载更新 / 重试下载"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/update_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_primary"
            android:text="安装更新"
            android:textAllCaps="false"
            android:textColor="@color/accent_on" />

        <Button
            android:id="@+id/update_browser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn"
            android:text="在浏览器查看发布页"
            android:textAllCaps="false"
            android:textColor="@color/text" />
    </LinearLayout>
</ScrollView>
